{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "builder-lead",
  "permissions": [
    {
      "action": "read",
      "resource": "*.env",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.example",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    }
  ],
  "agents": {
    "builder-lead": {
      "steps": 40
    },
    "product-manager": {
      "steps": 15
    },
    "tech-lead": {
      "steps": 25
    },
    "backend-dev": {
      "steps": 40
    },
    "frontend-dev": {
      "steps": 40
    },
    "tester": {
      "steps": 30
    },
    "code-reviewer": {
      "steps": 25
    }
  },
  "plugins": [
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "instructions": [
    "instructions/caveman.md",
    "instructions/context-mode.md"
  ]
}
