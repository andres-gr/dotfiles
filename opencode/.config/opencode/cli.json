{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system"
  },
  "animations": true,
  "scroll": {
    "speed": 2,
    "acceleration": false
  },
  "diffs": {
    "view": "auto",
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "show"
  },
  "tabs": {
    "mode": "off"
  },
  "keybinds": {
    "app.exit": [
      "ctrl+c",
      "<leader>q"
    ],
    "theme.switch": "none",
    "session.new": "none",
    "session.rename": "none",
    "session.child.next": "<leader>right",
    "session.child.previous": "<leader>left",
    "session.parent": "<leader>up",
    "session.page.up": [
      "pageup",
      "ctrl+u"
    ],
    "session.page.down": [
      "pagedown",
      "ctrl+d"
    ],
    "session.first": [
      "home",
      "ctrl+g"
    ],
    "session.message.next": "<leader>n",
    "session.message.previous": "<leader>p",
    "session.messages_last_user": "none",
    "agent.cycle": "tab",
    "agent.cycle.reverse": "shift+tab",
    "input.newline": "shift+return",
    "input.line.home": "ctrl+y",
    "input.buffer.home": "home",
    "input.buffer.end": "end",
    "input.delete.to.line.end": "ctrl+alt+l",
    "input.delete.to.line.start": "ctrl+alt+h",
    "input.delete": [
      "delete",
      "shift+delete"
    ]
  }
}
