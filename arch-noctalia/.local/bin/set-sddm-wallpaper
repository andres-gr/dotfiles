#!/usr/bin/env bash
# Set SDDM wallpaper from Noctalia current wallpaper
# Uses Noctalia IPC to get theme mode and wallpaper path (v5)

set -euo pipefail

THEME_NAME="sddm-noctalia-theme"
DEST_DIR="/usr/share/sddm/themes/$THEME_NAME/Assets/Wallpaper"
SETTINGS_CONF="/usr/share/sddm/themes/$THEME_NAME/Commons/Settings.conf"

# Determine dark/light mode via IPC (correct even with mode = "auto")
DARK_MODE="dark"
mode=$(noctalia msg theme-mode-get 2>/dev/null || echo "dark")
if [[ "$mode" == "light" ]]; then
  DARK_MODE="light"
fi

# Get current wallpaper path via IPC
WALLPAPER=$(noctalia msg wallpaper-get 2>/dev/null || true)

# Check if we got a valid wallpaper
if [[ -z "$WALLPAPER" || "$WALLPAPER" == "null" ]]; then
  echo "No wallpaper found via IPC"
  exit 1
fi

# Check if source file exists
if [[ ! -f "$WALLPAPER" ]]; then
  echo "Wallpaper file not found: $WALLPAPER"
  exit 1
fi

# Detect source extension and use it for destination
EXT="${WALLPAPER##*.}"
EXT="${EXT,,}"
if [[ "$EXT" != "png" && "$EXT" != "jpg" && "$EXT" != "jpeg" ]]; then
  EXT="png"
fi

# Ensure destination directory exists and is writable
mkdir -p "$DEST_DIR"
chmod 777 "$DEST_DIR" 2>/dev/null || true

# Destination filename (keep same extension as source)
DEST_FILE="$DEST_DIR/bg.$EXT"

# Copy wallpaper directly (no conversion)
cp -f "$WALLPAPER" "$DEST_FILE"

# Make file writable (Settings.conf is already world-writable)
chmod 666 "$DEST_FILE" 2>/dev/null || true

# Update Settings.conf to point to correct background file
# Only update the background line, preserve everything else
if [[ -f "$SETTINGS_CONF" ]]; then
  # Use /tmp for temp file, then cp (not mv) to preserve perms
  TMP_CONF=$(mktemp /tmp/sddm-settings.XXXX.conf)
  sed "s|^background=.*|background=Assets/Wallpaper/bg.$EXT|" "$SETTINGS_CONF" > "$TMP_CONF"
  cp -f "$TMP_CONF" "$SETTINGS_CONF"
  rm -f "$TMP_CONF"
  # Note: file is already 666 from install, no chmod needed
fi

echo "SDDM wallpaper updated: $WALLPAPER -> $DEST_FILE"